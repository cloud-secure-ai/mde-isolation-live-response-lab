// Mimikatz-style command lines and LSASS access attempts
// Author: Seán O'Farrell | https://cloud-secure.ai/
// Series: Simulating Defender for Endpoint machine isolation and remediation
let DeviceNameFilter = "";
let Lookback = 7d;
let Indicators = dynamic(["sekurlsa::", "lsadump::", "privilege::debug", "kerberos::", "token::elevate", "mimikatz"]);
union
(
    DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where isempty(DeviceNameFilter) or DeviceName has DeviceNameFilter
    | where ProcessCommandLine has_any (Indicators) or FileName =~ "mimikatz.exe"
    | project Timestamp, DeviceName, Source = "Process", FileName, ProcessCommandLine,
        AccountName, InitiatingProcessFileName, InitiatingProcessCommandLine
),
(
    DeviceEvents
    | where Timestamp > ago(Lookback)
    | where isempty(DeviceNameFilter) or DeviceName has DeviceNameFilter
    | where ActionType in ("OpenProcessApiCall", "AsrLsassCredentialTheftBlocked", "AsrLsassCredentialTheftAudited")
    | where FileName =~ "lsass.exe" or ActionType startswith "AsrLsass"
    | project Timestamp, DeviceName, Source = ActionType, FileName, ProcessCommandLine,
        AccountName = InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessCommandLine
)
| order by Timestamp desc
